# ─── Dependencies ─────────────────────────────────────────────────────────
# Despite npm workspaces hoisting, peer/optional/Yarn PnP can land sub-trees in
# each workspace. The double-asterisk covers any depth.
node_modules/
**/node_modules/
.pnp.*
.yarn/cache
.yarn/install-state.gz
.yarn/build-state.yml
.yarn/unplugged
*.tgz

# ─── Next.js build output (per-workspace + legacy root) ───────────────────
.next/
**/.next/
out/
**/out/
build/
**/build/
dist/
**/dist/

# ─── TypeScript build info ─────────────────────────────────────────────────
*.tsbuildinfo
**/*.tsbuildinfo
.tscache/

# ─── Next.js auto-generated env types (regenerated on `next dev`) ─────────
next-env.d.ts
**/next-env.d.ts

# ─── Vitest / coverage / nyc ──────────────────────────────────────────────
coverage/
**/coverage/
.vitest-cache/
.nyc_output/

# ─── Other JS-tool caches ─────────────────────────────────────────────────
.eslintcache
.parcel-cache/
.turbo/
**/.turbo/

# ─── Engine `verify` script artefact ──────────────────────────────────────
scripts/_test_output.xlsx
**/scripts/_test_output.xlsx

# ─── Logs ─────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Local environment files (none today, but be safe) ────────────────────
.env
.env.local
.env.*.local
**/.env
**/.env.local
**/.env.*.local

# ─── Vercel local artifacts (link config + local build output) ────────────
.vercel
.vercel/
**/.vercel
**/.vercel/

# ─── macOS noise (anywhere in the tree) ───────────────────────────────────
.DS_Store
._*
.AppleDouble
.Spotlight-V100
.Trashes

# ─── Windows noise ────────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini

# ─── Editor noise ─────────────────────────────────────────────────────────
.idea/
*.swp
*.swo
*~
# VS Code: ignore project-local config by default; whitelist what is meant to
# be committed (recommended extensions, debug launches, etc.) with `!path`.
.vscode/

# ─── Python (used by ad-hoc maintenance scripts) ──────────────────────────
__pycache__/
*.py[cod]

# ─── AI ─────────────────────────────────────────────────────────────────-─
.claude/